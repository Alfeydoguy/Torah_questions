# Copy this file to .env and fill it in.

# The password teachers type at /teachers. If left empty, a temporary
# password is printed when the site starts.
TEACHER_PASSWORD=

# Any long random string. Keeps teachers signed in when the site restarts.
SESSION_SECRET=

# The port the site runs on.
PORT=3000

# Where questions are saved. Defaults to data/questions.json.
DATA_FILE=

# Set to 1 when the site runs behind a hosting service's proxy
# (Render, Railway, Fly.io, and so on).
TRUST_PROXY=
